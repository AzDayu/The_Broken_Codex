.menu-container {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgb(20, 20, 20);
}

.title-text {
    font-size: 80px;
    color: rgb(0, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 50px;
    letter-spacing: 10px;
}

.menu-button {
    width: 300px;
    height: 60px;
    font-size: 30px;
    color: white;
    background-color: rgb(50, 50, 50);
    border-color: rgb(0, 255, 255);
    border-width: 2px;
    margin-bottom: 20px;
    transition-duration: 0.2s;
}

.menu-button:hover {
    background-color: rgb(0, 255, 255);
    color: black;
    scale: 1.05;
}