/* 전체 화면 덮개 */
.root-container {
    flex-direction: row;
    width: 100%;
    height: 100%;
    /* 패딩과 마진도 화면 크기에 맞게 유연하게 작동하도록 설정 */
    padding: 4%; 
    background-color: rgba(0, 0, 0, 0.85);
    /* 좌우 패널이 양끝으로 붙고 중간 간격이 일정하게 유지되도록 설정 */
    justify-content: space-between;
    align-items: center; /* 세로 정렬도 중앙으로 맞춤 */
}

/* 좌/우 메인 패널 공통 스타일 */
.main-panel {
    border-width: 4px;
    border-color: #ffffff;
    background-color: rgba(20, 20, 20, 0.9);
    padding: 2%;
    height: 90%; /* 화면 높이가 변해도 일정한 세로 비율 유지 */
}

/* 좌측 캐릭터 패널 */
#Left_PlayerPanel {
    width: 35%;
    align-items: center;
    justify-content: space-between;
}

/* 우측 인벤토리 패널 */
#Right_InventoryPanel {
    width: 60%;
}

/* 상단 타이틀 텍스트 테두리 스타일 */
.panel-title {
    font-size: 24px;
    color: white;
    -unity-font-style: bold;
    border-width: 3px;
    border-color: white;
    padding: 8px 0px;
    margin-bottom: 25px;
    width: 100%;
    -unity-text-align: middle-center;
}

/* 파편 수 텍스트 (우측 상단 포인트) */
.shard-title {
    border-color: #00ffcc;
    color: #00ffcc;
}

/* 캐릭터 초상화 박스 */
.portrait-box {
    width: 100%;
    flex-grow: 1; /* 스탯창을 제외한 남은 빈 공간을 꽉 채움 */
    max-height: 380px;
    border-width: 3px;
    border-color: white;
    margin-bottom: 20px;
    background-color: rgba(255, 255, 255, 0.05);
}

/* 스탯창 박스 */
.stats-box {
    width: 100%;
    height: 140px;
    border-width: 3px;
    border-color: white;
    padding: 15px;
    background-color: rgba(0, 0, 0, 0.4);
}

.stats-text {
    color: white;
    font-size: 18px;
}

/* 슬롯들이 담길 그리드 (캡처본에서 한 줄로 나오던 문제를 해결하는 핵심) */
.slot-grid {
    flex-direction: row;
    flex-wrap: wrap; /* 자리가 부족하면 아래 줄로 자동 줄바꿈 활성화 */
    justify-content: flex-start;
    align-content: flex-start;
    flex-grow: 1; /* 남은 아래 공간을 전부 그리드로 활용 */
    width: 100%;
    padding: 5px;
    background-color: rgba(0, 0, 0, 0.2);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

/* 개별 아이템 슬롯 스타일 (크기를 픽셀 단위로 명확하게 강제 고정) */
.item-slot {
    width: 75px;  /* 가로 크기 고정 */
    height: 75px; /* 세로 크기 고정 */
    min-width: 75px;
    min-height: 75px;
    border-width: 3px;
    border-color: #ffffff;
    margin: 8px; /* 슬롯들 사이의 사방 여백 */
    background-color: rgba(255, 255, 255, 0.07);
    justify-content: flex-end; /* 수량 텍스트가 우측 하단에 박히도록 설정 */
    padding: 3px;
}

/* 슬롯 마우스 호버 효과 */
.item-slot:hover {
    border-color: #00ffcc;
    background-color: rgba(0, 255, 204, 0.15);
}