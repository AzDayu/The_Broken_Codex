<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/GameUIStyle.uss?fileID=7433441132597879392&amp;guid=861a8344dbb95454d96b28fd24889fd4&amp;type=3#GameUIStyle"/>
    <ui:VisualElement name="MainContainer" style="flex-grow: 1; width: 100%; height: 100%;">
        <ui:VisualElement name="TopLeft_Panel" style="position: absolute; top: 0; left: 0; padding-top: 20px; padding-left: 20px; width: auto; height: auto;">
            <ui:Label text="Player Info" name="Label_PlayerInfo" class="unity-label" style="margin-bottom: 8px; position: relative; top: auto; left: auto;"/>
            <ui:VisualElement name="HP_Bar_BG" style="width: 150px; height: 15px; flex-direction: column; position: relative; top: auto; left: auto;">
                <ui:VisualElement name="Gauge_HP_Fill" style="flex-grow: 1; width: 100%; height: 100%; position: relative; top: auto; left: auto;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="TopCenter_Panel" style="position: absolute; top: 0; left: auto; translate: -10% 0; padding-top: 20px; align-items: center; width: auto; height: auto; right: 0;">
            <ui:VisualElement name="Gauge_Glitch_BG" style="width: 150px; height: 15px; flex-direction: column; position: relative; top: auto; left: auto;">
                <ui:VisualElement name="Gauge_Glitch_Fill" style="flex-grow: 1; width: 100%; height: 100%; position: relative; top: auto; left: auto;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Radar_Icon" style="width: 40px; height: 40px; margin-top: 10px; position: relative; top: auto; left: auto;"/>
        </ui:VisualElement>
        <ui:VisualElement name="BottomCenter_Panel" style="position: absolute; bottom: 0; left: 50%; translate: -50% 0; padding-bottom: 20px; align-items: center; width: auto; height: auto;">
            <ui:VisualElement name="Gauge_Shard_BG" style="width: 150px; height: 15px; flex-direction: column; position: relative; top: auto; left: auto;">
                <ui:VisualElement name="Gauge_Shard_Fill" style="flex-grow: 1; width: 100%; height: 100%; position: relative; top: auto; left: auto;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
